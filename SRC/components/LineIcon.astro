---
// Thin line icons (stroke uses currentColor). Usage: <LineIcon name="sun" class="h-7 w-7 text-clay" />
const { name, class: cls = "h-6 w-6" } = Astro.props;
const paths: Record<string, string> = {
  // steady glucose curve
  wave: '<path d="M3 20h18"/><path d="M3 14c2.5 0 3-4 5.5-4s3 3 5.5 3 3-2 7-2"/>',
  // apple
  apple: '<path d="M12 7c-1.5-1.6-4.5-2-6 0-2 2.6-.5 8 1.5 10.5C9 19.5 10.5 20 12 19c1.5 1 3 .5 4.5-1.5C18.5 15 20 9.6 18 7c-1.5-2-4.5-1.6-6 0z"/><path d="M12 7c0-2 1-3.5 3-4"/>',
  // tape measure
  tape: '<circle cx="9" cy="12" r="6"/><circle cx="9" cy="12" r="1.5"/><path d="M15 12v6h6"/><path d="M18 18v-2M15 15h1.5"/>',
  // sun
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>',
  // clipboard with pulse
  clipboard: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1"/><path d="M7.5 13h2l1.5-3 2 5 1.5-2h2"/>',
  // two simple steps / check
  check: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/>',
  // shield (guarantee)
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  // flask (science)
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3"/><path d="M7.5 15h9"/>',
  // heart (faith-centered)
  heart: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/><path d="M12 9v6M9.5 11.5h5"/>',
  // box (ships)
  box: '<path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5L12 12l8.5-4.5M12 12v9"/>',
};
---
<svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name] ?? ""}></svg>

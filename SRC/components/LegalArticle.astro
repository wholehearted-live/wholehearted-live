---
// Shared wrapper for the legal / SMS compliance pages (privacy, SMS terms, opt-in).
// Used inside ProtocolLayout so the pages match metabolicmolly.com/protocol.
const { heading, updated } = Astro.props;
---

<article class="legal mx-auto max-w-3xl px-4 py-12 sm:px-6">
  <h1 class="brand-font text-3xl sm:text-4xl text-ink">{heading}</h1>
  {updated && <p class="mt-2 text-sm text-ink/60">Last updated: {updated}</p>}
  <div class="mt-8">
    <slot />
  </div>
  <p class="mt-12 border-t border-ink/10 pt-6 text-sm text-ink/60">
    <a href="/privacy/">Privacy Policy</a> ·
    <a href="/sms-terms/">SMS Terms &amp; Conditions</a> ·
    <a href="/sms-opt-in/">How Text Opt-In Works</a>
  </p>
</article>

<style is:global>
  .legal h2 { font-family: var(--font-brand); font-size: 1.35rem; color: var(--color-wine); margin-top: 2.25rem; margin-bottom: 0.75rem; }
  .legal h3 { font-weight: 600; margin-top: 1.25rem; margin-bottom: 0.5rem; }
  .legal p { line-height: 1.7; margin-bottom: 1rem; color: color-mix(in srgb, var(--color-ink) 85%, transparent); }
  .legal ul { list-style: disc; padding-left: 1.4rem; margin-bottom: 1rem; }
  .legal li { line-height: 1.7; margin-bottom: 0.35rem; color: color-mix(in srgb, var(--color-ink) 85%, transparent); }
  .legal a { color: var(--color-wine); text-decoration: underline; text-underline-offset: 2px; }
  .legal strong { color: var(--color-ink); }
</style>

---
import LineIcon from "./LineIcon.astro";
const badges = [
  { icon: "shield", label: "90-Day Money-Back Guarantee" },
  { icon: "flask", label: "Science-Backed Formula" },
  { icon: "heart", label: "Faith-Centered Coaching" },
  { icon: "box", label: "Ships to Your Door" },
];
---

<div class="border-y border-ink/10 bg-white/60">
  <div class="mx-auto max-w-5xl px-4 py-4">
    <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      {
        badges.map((badge) => (
          <li class="flex items-center gap-2 text-sm font-medium text-ink/70">
            <LineIcon name={badge.icon} class="h-5 w-5 text-clay" />
            {badge.label}
          </li>
        ))
      }
    </ul>
  </div>
</div>

---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { LINKS } from "../data/links";

const {
  title = "WholeHearted — Faith, Wellness & Community",
  description = "WholeHearted helps families reclaim their health — body, mind, and spirit — through faith-centered wellness education and the Feel Great System.",
  index = false,
  image = "/og-default.jpg",
  canonical = Astro.url.href,
} = Astro.props;

const siteName = "WholeHearted";
const siteUrl = "https://wholehearted.live";

// Tells search engines who runs the site and which social profiles belong to it.
const socialProfiles = Object.values(LINKS.social).filter(Boolean);
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  url: siteUrl,
  logo: `${siteUrl}/logo-wholehearted-living.png`,
  email: "hello@wholehearted.live",
  telephone: "+1-513-650-6639",
  address: {
    "@type": "PostalAddress",
    streetAddress: "1671 Big Bear Dr.",
    addressLocality: "Centerville",
    addressRegion: "OH",
    postalCode: "45458",
    addressCountry: "US",
  },
  founder: {
    "@type": "Person",
    name: "Molly Broad",
    alternateName: "Metabolic Molly",
    image: `${siteUrl}/team/molly.jpg`,
    url: `${siteUrl}/about/`,
    sameAs: socialProfiles,
  },
  sameAs: socialProfiles,
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />

  <!-- Search engine indexing: controlled per-page via `index` prop -->
  <meta name="robots" content={index ? "index, follow" : "noindex, nofollow"} />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content={siteName} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url"         content={canonical} />
  <meta property="og:image"       content={`${siteUrl}${image}`} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale"      content="en_US" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={`${siteUrl}${image}`} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&display=swap"
    rel="stylesheet"
  />

  <title>{title}</title>

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <!-- GoHighLevel tracking -->
  <script
    src="https://link.msgsndr.com/js/external-tracking.js"
    data-tracking-id="tk_252c40d4690b453f9f9795810f909b8f"
  ></script>
</head>

  <body class="min-h-screen text-ink">
    <Header />
    <main class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>

    <Footer />

    <!-- GoHighLevel Chat Widget -->
    <script src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="6ac80de00e60a54e32d925a1" is:inline></script>
  </body>
</html>
